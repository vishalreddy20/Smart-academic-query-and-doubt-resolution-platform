# Example environment variables for local development
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and will override `.env`.
# Set a secure admin invite code (used to protect admin registration).
VITE_ADMIN_INVITE_CODE=replace-with-strong-code
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key
